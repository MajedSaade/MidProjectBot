[Unit]
Description=Discord Image Processing Bot
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/MidProjectBot
# Use our wrapper script to start the bot
ExecStart=/home/ubuntu/MidProjectBot/run_bot.sh

Restart=always
RestartSec=10
# Add more logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target 