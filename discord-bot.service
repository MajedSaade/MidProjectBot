[Unit]
Description=Discord Polybot Service
After=network.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/MidProjectBot
ExecStart=/home/ubuntu/MidProjectBot/venv/bin/python -m polybot.app
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
# Load environment variables from file
EnvironmentFile=/home/ubuntu/MidProjectBot/.env

[Install]
WantedBy=multi-user.target 