[Unit]
Description=Discord Image Processing Bot
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/MidProjectBot
Environment="PATH=/home/ubuntu/MidProjectBot/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/ubuntu/MidProjectBot/.env
Environment="YOLO_URL=http://10.0.1.90:8081/predict"
Environment="OLLAMA_URL=http://10.0.0.136:11434/api/chat"
Environment="OLLAMA_MODEL=gemma3:1b"
Environment="STATUS_SERVER_PORT=8443"
ExecStart=/bin/bash -c 'source /home/ubuntu/MidProjectBot/venv/bin/activate && DISCORD_BOT_TOKEN="$DISCORD_BOT_TOKEN" python /home/ubuntu/MidProjectBot/polybot/app.py'
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target 